#!/bin/bash

# Проверяем, что аргумент передан
if [ $# -eq 0 ]; then
    echo "Использование: $0 \"текст\""
    exit 1
fi

# Склеиваем все аргументы в одну строку (на случай, если текст без кавычек)
text="$*"

# Вычисляем длину текста
len=${#text}

# Строим горизонтальную линию: 2 пробела по бокам + длина текста
line="+"
for ((i = 0; i < len + 2; i++)); do
    line+="-"
done
line+="+"

# Печатаем баннер
echo "$line"
echo "| $text |"
echo "$line"
